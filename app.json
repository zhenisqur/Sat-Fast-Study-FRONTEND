{
  "expo": {
    "name": "SAT GG",
    "slug": "sat-gg",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#6A5ACD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.satgg.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6A5ACD"
      },
      "package": "com.satgg.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      "expo-video",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "2dd704ed-ded7-4fbd-ac22-82cf08ccf8be"
      }
    }
  }
}